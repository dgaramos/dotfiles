#!/bin/sh
# run_onchange_06-configure-git — wire delta config into git global config
# macOS only: git config on servers is managed locally

set -eu

{{ if ne .chezmoi.os "darwin" -}}
exit 0
{{ end -}}

if ! command -v git >/dev/null 2>&1; then
    exit 0
fi

# Prompt for git identity if not set via local-env
if [ -z "${GIT_NAME:-}" ]; then
    printf "Git user name: "
    read -r GIT_NAME
    local-env set GIT_NAME "$GIT_NAME"
fi

if [ -z "${GIT_EMAIL:-}" ]; then
    printf "Git email: "
    read -r GIT_EMAIL
    local-env set GIT_EMAIL "$GIT_EMAIL"
fi

git config --global user.name "$GIT_NAME"
git config --global user.email "$GIT_EMAIL"

# Wire delta config via include
DELTA_CONFIG="$HOME/.config/delta/config"
if ! git config --global --get-all include.path 2>/dev/null | grep -qF "$DELTA_CONFIG"; then
    git config --global --add include.path "$DELTA_CONFIG"
fi

git config --global core.pager delta
git config --global interactive.diffFilter 'delta --color-only'
