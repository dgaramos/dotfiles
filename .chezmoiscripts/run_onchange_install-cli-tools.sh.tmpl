#!/bin/sh
set -eu

install_brew() {
    if command -v brew >/dev/null 2>&1; then
        brew install "$@" || true
    fi
}

install_apt() {
    if command -v apt >/dev/null 2>&1; then
        sudo apt update
        sudo apt install -y "$@" || true
    fi
}

install_pacman() {
    if command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --needed --noconfirm "$@" || true
    fi
}

install_dnf() {
    if command -v dnf >/dev/null 2>&1; then
        for pkg in "$@"; do
            sudo dnf install -y "$pkg" || true
        done
    fi
}

install_dnf_webi() {
    if ! command -v "$1" >/dev/null 2>&1; then
        curl -sS "https://webi.sh/$1" | sh || true
    fi
}

install_starship() {
    if ! command -v starship >/dev/null 2>&1; then
        curl -sS https://starship.rs/install.sh | sh -s -- --yes
    fi
}

install_gh() {
    if ! command -v gh >/dev/null 2>&1; then
        curl -sS https://webi.sh/gh | sh
    fi
}

if command -v brew >/dev/null 2>&1; then
    install_brew fzf zoxide ripgrep fd bat eza direnv delta starship gh
elif command -v apt >/dev/null 2>&1; then
    install_apt fzf ripgrep fd-find bat direnv delta
    install_apt zoxide
    install_apt eza
    install_starship
elif command -v dnf >/dev/null 2>&1; then
    # Use webi for tools not in standard Amazon Linux repos
    install_dnf_webi fzf
    install_dnf_webi zoxide
    install_dnf_webi rg
    install_dnf_webi fd
    install_dnf_webi bat
    install_dnf_webi direnv
    install_dnf_webi delta
    # eza is not on webi — install from GitHub release
    if ! command -v eza >/dev/null 2>&1; then
        EZA_URL="https://github.com/eza-community/eza/releases/latest/download/eza_aarch64-unknown-linux-musl.tar.gz"
        curl -fLo /tmp/eza.tar.gz "$EZA_URL" && \
            tar -xzf /tmp/eza.tar.gz -C ~/.local/bin eza && \
            rm /tmp/eza.tar.gz || true
    fi
    install_starship
elif command -v pacman >/dev/null 2>&1; then
    install_pacman fzf zoxide ripgrep fd bat eza direnv git-delta starship
fi
