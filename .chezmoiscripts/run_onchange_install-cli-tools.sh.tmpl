#!/bin/sh
set -eu

install_brew() {
    if command -v brew >/dev/null 2>&1; then
        brew install "$@" || true
    fi
}

install_apt() {
    if command -v apt >/dev/null 2>&1; then
        sudo apt update
        sudo apt install -y "$@" || true
    fi
}

install_pacman() {
    if command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --needed --noconfirm "$@" || true
    fi
}

install_dnf() {
    if command -v dnf >/dev/null 2>&1; then
        sudo dnf install -y "$@" || true
    fi
}

install_starship() {
    if ! command -v starship >/dev/null 2>&1; then
        curl -sS https://starship.rs/install.sh | sh -s -- --yes
    fi
}

if command -v brew >/dev/null 2>&1; then
    install_brew fzf zoxide ripgrep fd bat eza direnv delta starship
elif command -v apt >/dev/null 2>&1; then
    install_apt fzf ripgrep fd-find bat direnv delta
    install_apt zoxide
    install_apt eza
    install_starship
elif command -v dnf >/dev/null 2>&1; then
    install_dnf fzf zoxide ripgrep fd-find bat eza direnv git-delta
    install_starship
elif command -v pacman >/dev/null 2>&1; then
    install_pacman fzf zoxide ripgrep fd bat eza direnv delta starship
fi
