#!/bin/sh
set -eu

install_brew() {
    if command -v brew >/dev/null 2>&1; then
        brew install "$@" || true
    fi
}

install_apt() {
    if command -v apt >/dev/null 2>&1; then
        sudo apt update
        sudo apt install -y "$@" || true
    fi
}

install_pacman() {
    if command -v pacman >/dev/null 2>&1; then
        sudo pacman -S --needed --noconfirm "$@" || true
    fi
}

install_dnf() {
    if command -v dnf >/dev/null 2>&1; then
        for pkg in "$@"; do
            sudo dnf install -y "$pkg" || true
        done
    fi
}

install_github_release() {
    local cmd="$1"
    local url="$2"
    local binary="${3:-$cmd}"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        curl -fLo /tmp/_install.tar.gz "$url" && \
            tar -xzf /tmp/_install.tar.gz -C /tmp && \
            find /tmp -maxdepth 2 -name "$binary" -type f | head -1 | xargs -I{} mv {} ~/.local/bin/"$cmd" && \
            chmod +x ~/.local/bin/"$cmd" && \
            rm -f /tmp/_install.tar.gz || true
    fi
}

install_starship() {
    if ! command -v starship >/dev/null 2>&1; then
        curl -sS https://starship.rs/install.sh | sh -s -- --yes
    fi
}

install_gh() {
    if ! command -v gh >/dev/null 2>&1; then
        curl -sS https://webi.sh/gh | sh
    fi
}

if command -v brew >/dev/null 2>&1; then
    install_brew fzf zoxide ripgrep fd bat eza direnv delta starship gh
elif command -v apt >/dev/null 2>&1; then
    install_apt fzf ripgrep fd-find bat direnv delta
    install_apt zoxide
    install_apt eza
    install_starship
elif command -v dnf >/dev/null 2>&1; then
    mkdir -p ~/.local/bin
    install_github_release fzf \
        "https://github.com/junegunn/fzf/releases/latest/download/fzf-linux_arm64.tar.gz"
    install_github_release zoxide \
        "https://github.com/ajeetdsouza/zoxide/releases/latest/download/zoxide-aarch64-unknown-linux-musl.tar.gz"
    install_github_release rg \
        "https://github.com/BurntSushi/ripgrep/releases/latest/download/ripgrep-aarch64-unknown-linux-musl.tar.gz" rg
    install_github_release fd \
        "https://github.com/sharkdp/fd/releases/latest/download/fd-aarch64-unknown-linux-musl.tar.gz" fd
    install_github_release bat \
        "https://github.com/sharkdp/bat/releases/latest/download/bat-aarch64-unknown-linux-musl.tar.gz" bat
    install_github_release delta \
        "https://github.com/dandavison/delta/releases/latest/download/delta-aarch64-unknown-linux-gnu.tar.gz" delta
    install_github_release eza \
        "https://github.com/eza-community/eza/releases/latest/download/eza_aarch64-unknown-linux-musl.tar.gz" eza
    if ! command -v direnv >/dev/null 2>&1; then
        curl -sfL https://direnv.net/install.sh | bash || true
    fi
    install_starship
elif command -v pacman >/dev/null 2>&1; then
    install_pacman fzf zoxide ripgrep fd bat eza direnv git-delta starship
fi
