[[ -d "$HOME/Emulation" ]] &&
    alias emu='cd ~/Emulation'

[[ -d "$HOME/Emulation/roms" ]] &&
    alias roms='cd ~/Emulation/roms'

[[ -d "$HOME/Emulation/bios" ]] &&
    alias bios='cd ~/Emulation/bios'

[[ -d "$HOME/homebrew" ]] &&
    alias decky='cd ~/homebrew'
